{
    "name": "maico/one-stop-client",
    "description": "Optional \"Sign in with MAICO One-Stop\" for Laravel applications: single sign-on, sign-out notices and opening inside One-Stop.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Maico\\OneStop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maico\\OneStop\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maico\\OneStop\\OneStopServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
